# Build the preview image first: docker compose build blog
FROM node:24-bookworm AS node
FROM mdbeckergithubio-blog:latest
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Browser revisions track the repository's locked Playwright version.
WORKDIR /test-tools
COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium firefox
WORKDIR /work
CMD ["sh", "-c", "cp -a /repo/. /work/ && cp -a /test-tools/node_modules /work/ && mkdir -p /tmp/historical && git archive --output=/tmp/historical.tar f956b53210bd3985408a766f431e5455c02e2459 && tar -xf /tmp/historical.tar -C /tmp/historical && bundle exec ruby tests/copyright.rb && bundle exec jekyll build && HISTORICAL_SITE=/tmp/historical npm test"]
